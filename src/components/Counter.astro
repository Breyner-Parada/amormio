---
import { config } from '../data/config';
const units = [
	['days', 'Días'],
	['hours', 'Horas'],
	['minutes', 'Minutos'],
	['seconds', 'Segundos'],
];
---

<section id="contador" class="mx-auto max-w-4xl px-6 py-28 text-center" data-start={config.startDate}>
	<h2 data-reveal class="font-script text-5xl text-rose-deep md:text-6xl">Y seguimos sumando...</h2>
	<p data-reveal class="mt-3 font-light text-wine/70">Tiempo eligiéndonos cada día</p>

	<div class="mt-12 grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
		{
			units.map(([key, label]) => (
				<div data-reveal class="glass rounded-3xl px-4 py-8">
					<div data-unit={key} class="text-gradient font-display text-5xl font-bold tabular-nums md:text-6xl">
						0
					</div>
					<div class="mt-2 text-xs tracking-widest text-rose-deep/70 uppercase">{label}</div>
				</div>
			))
		}
	</div>
</section>

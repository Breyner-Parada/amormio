---
interface Props {
	class?: string;
	gradient?: boolean;
}
const { class: className = '', gradient = false } = Astro.props;
const id = `hg-${Math.random().toString(36).slice(2, 8)}`;
---

<svg viewBox="0 0 24 24" class={className} aria-hidden="true">
	{
		gradient && (
			<defs>
				<linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" stop-color="#ff7a9c" />
					<stop offset="1" stop-color="#b3204a" />
				</linearGradient>
			</defs>
		)
	}
	<path
		fill={gradient ? `url(#${id})` : 'currentColor'}
		d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
	></path>
</svg>

---
const btn =
	'absolute z-10 grid h-12 w-12 place-items-center rounded-full bg-white/15 text-white backdrop-blur transition hover:bg-white/30 focus-visible:outline-2 focus-visible:outline-white';
---

<div
	id="lightbox"
	class="fixed inset-0 z-[60] hidden items-center justify-center bg-wine/90 p-4 backdrop-blur-md"
	role="dialog"
	aria-modal="true"
	aria-label="Foto ampliada"
>
	<button id="lb-close" type="button" aria-label="Cerrar" class:list={[btn, 'top-4 right-4']}>
		<svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
			><path d="M6 6l12 12M18 6L6 18"></path></svg
		>
	</button>
	<button id="lb-prev" type="button" aria-label="Foto anterior" class:list={[btn, 'top-1/2 left-3 -translate-y-1/2 sm:left-6']}>
		<svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
			><path d="M15 5l-7 7 7 7"></path></svg
		>
	</button>
	<button id="lb-next" type="button" aria-label="Foto siguiente" class:list={[btn, 'top-1/2 right-3 -translate-y-1/2 sm:right-6']}>
		<svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
			><path d="M9 5l7 7-7 7"></path></svg
		>
	</button>

	<figure id="lb-figure" class="polaroid-static touch-pan-y select-none">
		<img id="lb-img" src="" alt="" class="block max-h-[70vh] max-w-[calc(100vw-5rem)] object-contain sm:max-w-[min(80vw,900px)]" draggable="false" />
		<figcaption class="mt-3 flex items-baseline justify-between gap-6 px-1">
			<span id="lb-caption" class="font-script text-2xl text-rose-deep sm:text-3xl"></span>
			<span id="lb-count" class="text-xs tracking-widest text-rose-deep/60"></span>
		</figcaption>
	</figure>
</div>

---
import Layout from '../layouts/Layout.astro';
import Envelope from '../components/Envelope.astro';
import Hero from '../components/Hero.astro';
import Story from '../components/Story.astro';
import Gallery from '../components/Gallery.astro';
import Reasons from '../components/Reasons.astro';
import Counter from '../components/Counter.astro';
import Finale from '../components/Finale.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import Letter from '../components/Letter.astro';
import Lightbox from '../components/Lightbox.astro';
import AmbientBackground from '../components/AmbientBackground.astro';
import { config } from '../data/config';
---

<Layout title={config.pageTitle}>
	<Envelope />
	<AmbientBackground />
	<main id="content" class="relative z-10">
		<Hero />
		<Story />
		<Gallery />
		<Reasons />
		<Counter />
		<Letter />
		<Finale />
	</main>
	<Lightbox />
	<MusicPlayer />
</Layout>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const HEART =
		'<svg viewBox="0 0 24 24" width="100%" height="100%"><path fill="currentColor" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>';

	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	/** Corazones que suben flotando dentro de un contenedor */
	function floatingHearts(container: HTMLElement, count: number) {
		if (reduced) return;
		for (let i = 0; i < count; i++) {
			const el = document.createElement('div');
			const size = gsap.utils.random(14, 38);
			el.innerHTML = HEART;
			el.className = 'absolute text-rose-soft';
			Object.assign(el.style, {
				width: `${size}px`,
				height: `${size}px`,
				left: `${gsap.utils.random(0, 100)}%`,
				top: '105%',
				opacity: '0',
			});
			container.appendChild(el);
			gsap.to(el, {
				y: () => -(container.clientHeight + 150),
				x: `+=${gsap.utils.random(-60, 60)}`,
				rotation: gsap.utils.random(-40, 40),
				opacity: gsap.utils.random(0.35, 0.75),
				duration: gsap.utils.random(7, 14),
				delay: gsap.utils.random(0, 10),
				repeat: -1,
				ease: 'none',
			});
		}
	}

	// ---------- Estado inicial ----------
	const intro = document.getElementById('intro')!;
	const envelope = document.getElementById('envelope')!;
	const flap = document.getElementById('env-flap')!;
	const letter = document.getElementById('env-letter')!;
	const seal = envelope.querySelector('.env-seal')!;
	const hint = document.getElementById('intro-hint')!;

	floatingHearts(document.getElementById('intro-hearts')!, 14);

	gsap.set('[data-hero]', { opacity: 0, y: 40 });
	gsap.from(envelope, { y: 60, scale: 0.85, opacity: 0, duration: 1.2, ease: 'back.out(1.6)' });
	gsap.from(hint, { opacity: 0, y: 20, duration: 1, delay: 0.6 });

	// Latido del sello + balanceo suave del sobre
	const idle = gsap.timeline({ repeat: -1 });
	idle
		.to(seal, { scale: 1.18, duration: 0.35, ease: 'power2.out' })
		.to(seal, { scale: 1, duration: 0.5, ease: 'power2.in' })
		.to({}, { duration: 0.6 });
	const sway = gsap.to(envelope, { rotation: 1.5, yoyo: true, repeat: -1, duration: 2.2, ease: 'sine.inOut' });
	const hintPulse = gsap.to(hint, { opacity: 0.45, yoyo: true, repeat: -1, duration: 1.1, ease: 'sine.inOut', delay: 1.6 });

	// ---------- Abrir el sobre ----------
	let opened = false;
	envelope.addEventListener('click', () => {
		if (opened) return;
		opened = true;
		idle.kill();
		sway.kill();
		hintPulse.kill();
		startMusic(); // debe llamarse dentro del clic para que el navegador permita el audio

		const tl = gsap.timeline({ defaults: { ease: 'power3.inOut' } });
		tl.to(envelope, { rotation: 0, duration: 0.3 })
			.to(seal, { scale: 1.5, duration: 0.25, ease: 'power2.out' })
			.to(seal, { scale: 0, opacity: 0, rotation: 25, duration: 0.35, ease: 'back.in(2)' })
			.to(hint, { opacity: 0, y: 20, duration: 0.4 }, '<')
			.to(flap, { rotateX: 180, duration: 0.8 }, '-=0.1')
			.set(flap, { zIndex: 1 }, '<0.35')
			.to(letter, { y: () => -envelope.clientHeight * 0.5, duration: 0.9, ease: 'power2.out' })
			.set(letter, { zIndex: 6 })
			.to(letter, { scale: 1.45, duration: 0.7 }, '+=0.1')
			.to(envelope, { opacity: 0, scale: 1.4, duration: 0.7 }, '<0.2')
			.to(intro, { opacity: 0, duration: 0.7 }, '<0.1')
			.add(() => {
				intro.remove();
				document.documentElement.classList.remove('locked');
				ScrollTrigger.refresh();
				startContent();
			});
	});

	// ---------- Música ----------
	const audio = document.getElementById('bg-music') as HTMLAudioElement;
	const musicBtn = document.getElementById('music-toggle')!;
	const targetVolume = Number(audio.dataset.volume ?? 0.5);
	let musicFailed = false;

	// Sin archivo de música, el botón simplemente no aparece
	function disableMusic() {
		musicFailed = true;
		musicBtn.remove();
	}
	audio.addEventListener('error', disableMusic);
	if (audio.error) disableMusic(); // el error pudo ocurrir antes de que corriera este script

	function syncMusicButton() {
		const playing = !audio.paused;
		musicBtn.setAttribute('aria-pressed', String(playing));
		musicBtn.setAttribute('aria-label', playing ? 'Pausar música' : 'Reproducir música');
		musicBtn.classList.toggle('is-paused', !playing);
	}
	audio.addEventListener('play', syncMusicButton);
	audio.addEventListener('pause', syncMusicButton);

	function startMusic() {
		if (musicFailed) return;
		audio.volume = 0;
		audio
			.play()
			.then(() => gsap.to(audio, { volume: targetVolume, duration: 3, ease: 'power1.in' }))
			.catch((err) => {
				if (err?.name === 'NotSupportedError') disableMusic();
			});
	}

	musicBtn.addEventListener('click', () => {
		if (audio.paused) {
			audio
				.play()
				.then(() => gsap.to(audio, { volume: targetVolume, duration: 1 }))
				.catch(() => {});
		} else {
			audio.pause();
		}
	});

	// ---------- Contenido ----------
	function startContent() {
		if (!musicFailed && document.body.contains(musicBtn)) {
			musicBtn.classList.replace('hidden', 'flex');
			gsap.to(musicBtn, { opacity: 1, duration: 1, delay: 1 });
		}

		floatingHearts(document.getElementById('ambient-hearts')!, 22);

		gsap.to('[data-hero]', { opacity: 1, y: 0, duration: 1.2, stagger: 0.25, ease: 'power3.out' });
		gsap.to('#scroll-cue', { scaleY: 0.4, transformOrigin: 'top', yoyo: true, repeat: -1, duration: 1, ease: 'sine.inOut' });
		gsap.to('#final-heart', { scale: 1.12, duration: 0.5, yoyo: true, repeat: -1, ease: 'power1.inOut' });
	}

	// Revelar elementos al hacer scroll
	gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((el) => {
		gsap.from(el, { scrollTrigger: { trigger: el, start: 'top 88%' }, y: 40, opacity: 0, duration: 1, ease: 'power3.out' });
	});

	gsap.utils.toArray<HTMLElement>('[data-reveal-side]').forEach((el) => {
		const dir = el.dataset.revealSide === 'left' ? -60 : 60;
		gsap.from(el, { scrollTrigger: { trigger: el, start: 'top 85%' }, x: dir, opacity: 0, duration: 1, ease: 'power3.out' });
	});

	gsap.utils.toArray<HTMLElement>('[data-photo]').forEach((el, i) => {
		gsap.fromTo(
			el,
			{ y: 80, scale: 0.8, opacity: 0, rotation: gsap.utils.random(-12, 12) },
			{
				scrollTrigger: { trigger: el, start: 'top 90%' },
				y: 0,
				scale: 1,
				opacity: 1,
				rotation: Number(el.dataset.tilt),
				duration: 1,
				delay: (i % 3) * 0.12,
				ease: 'back.out(1.4)',
			}
		);
	});

	gsap.from('[data-reason]', {
		scrollTrigger: { trigger: '#razones', start: 'top 70%' },
		y: 50,
		opacity: 0,
		scale: 0.9,
		duration: 0.8,
		stagger: 0.12,
		ease: 'power3.out',
	});

	// ---------- Carta: se escribe sola ----------
	const typeGroups = gsap.utils.toArray<HTMLElement>('[data-type]').map((el) => {
		const text = el.textContent!.trim();
		const chars: HTMLElement[] = [];
		el.setAttribute('aria-label', text);
		el.textContent = '';
		text.split(/\s+/).forEach((word, wi, words) => {
			// Cada palabra va en un bloque para que el salto de línea no corte palabras a la mitad
			const w = document.createElement('span');
			w.className = 'type-word';
			w.setAttribute('aria-hidden', 'true');
			for (const ch of Array.from(word)) {
				const c = document.createElement('span');
				c.className = 'type-char';
				c.textContent = ch;
				w.appendChild(c);
				chars.push(c);
			}
			el.appendChild(w);
			if (wi < words.length - 1) el.appendChild(document.createTextNode(' '));
		});
		return chars;
	});

	if (reduced) {
		gsap.set(typeGroups.flat(), { opacity: 1 });
	} else {
		const typing = gsap.timeline({ paused: true });
		typeGroups.forEach((chars) => typing.to(chars, { opacity: 1, duration: 0.05, stagger: 0.022, ease: 'none' }, '+=0.5'));
		ScrollTrigger.create({ trigger: '#letter-paper', start: 'top 65%', once: true, onEnter: () => typing.play() });
	}

	// ---------- Galería ampliada ----------
	const lb = document.getElementById('lightbox')!;
	const lbFigure = document.getElementById('lb-figure')!;
	const lbImg = document.getElementById('lb-img') as HTMLImageElement;
	const lbCaption = document.getElementById('lb-caption')!;
	const lbCount = document.getElementById('lb-count')!;
	const thumbs = Array.from(document.querySelectorAll<HTMLElement>('[data-photo][data-src]'));
	let current = -1;
	let lastFocus: HTMLElement | null = null;

	async function showPhoto(index: number, dir: number) {
		current = (index + thumbs.length) % thumbs.length;
		const t = thumbs[current];
		lbImg.src = t.dataset.src!;
		lbImg.alt = t.dataset.caption ?? '';
		lbCaption.textContent = t.dataset.caption ?? '';
		lbCount.textContent = `${current + 1} / ${thumbs.length}`;
		await lbImg.decode().catch(() => {});
		for (const n of [current - 1, current + 1]) new Image().src = thumbs[(n + thumbs.length) % thumbs.length].dataset.src!;
		gsap.fromTo(
			lbFigure,
			{ x: dir * 90, scale: dir ? 1 : 0.85, opacity: 0, rotation: dir * 4 },
			{ x: 0, scale: 1, opacity: 1, rotation: Number(t.dataset.tilt) / 2, duration: 0.5, ease: 'power3.out' }
		);
	}

	function openPhoto(index: number) {
		lastFocus = document.activeElement as HTMLElement;
		lb.classList.replace('hidden', 'flex');
		document.documentElement.classList.add('lb-open');
		gsap.fromTo(lb, { opacity: 0 }, { opacity: 1, duration: 0.3 });
		showPhoto(index, 0);
		document.getElementById('lb-close')!.focus();
	}

	function closePhoto() {
		if (current < 0) return;
		current = -1;
		gsap.to(lb, {
			opacity: 0,
			duration: 0.25,
			onComplete: () => {
				lb.classList.replace('flex', 'hidden');
				document.documentElement.classList.remove('lb-open');
				lastFocus?.focus({ preventScroll: true });
			},
		});
	}

	thumbs.forEach((t, i) => {
		t.addEventListener('click', () => openPhoto(i));
		t.addEventListener('keydown', (e) => {
			if (e.key === 'Enter' || e.key === ' ') {
				e.preventDefault();
				openPhoto(i);
			}
		});
	});
	document.getElementById('lb-close')!.addEventListener('click', closePhoto);
	document.getElementById('lb-prev')!.addEventListener('click', () => showPhoto(current - 1, -1));
	document.getElementById('lb-next')!.addEventListener('click', () => showPhoto(current + 1, 1));
	lb.addEventListener('click', (e) => {
		if (e.target === lb) closePhoto();
	});
	document.addEventListener('keydown', (e) => {
		if (current < 0) return;
		if (e.key === 'Escape') closePhoto();
		if (e.key === 'ArrowLeft') showPhoto(current - 1, -1);
		if (e.key === 'ArrowRight') showPhoto(current + 1, 1);
	});
	// Deslizar con el dedo para cambiar de foto
	let swipeX = 0;
	lb.addEventListener('pointerdown', (e) => (swipeX = e.clientX));
	lb.addEventListener('pointerup', (e) => {
		const dx = e.clientX - swipeX;
		if (current >= 0 && Math.abs(dx) > 60 && (e.target as HTMLElement).closest('#lb-figure')) {
			showPhoto(current + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
		}
	});

	// ---------- Efectos de fondo y cursor ----------
	if (!reduced) {
		// Resplandores que se desplazan a distinta velocidad con el scroll
		const scrub = { trigger: document.body, start: 'top top', end: 'bottom bottom', scrub: 1.2 };
		gsap.to('.glow-a', { y: -420, x: 80, ease: 'none', scrollTrigger: scrub });
		gsap.to('.glow-b', { y: 380, x: -80, ease: 'none', scrollTrigger: scrub });
		gsap.to('.glow-c', { y: -300, x: 120, ease: 'none', scrollTrigger: scrub });
	}

	const HEART_COLORS = ['#e5486f', '#f6a5b9', '#ff7a9c', '#b3204a'];

	function spawnHeart(x: number, y: number, dx: number, dy: number, size: number, duration: number) {
		const el = document.createElement('div');
		el.innerHTML = HEART;
		Object.assign(el.style, {
			position: 'fixed',
			left: `${x}px`,
			top: `${y}px`,
			width: `${size}px`,
			height: `${size}px`,
			pointerEvents: 'none',
			zIndex: '45',
			color: HEART_COLORS[Math.floor(Math.random() * HEART_COLORS.length)],
		});
		document.body.appendChild(el);
		gsap.fromTo(
			el,
			{ xPercent: -50, yPercent: -50, scale: 0.3, opacity: 0.9 },
			{ x: dx, y: dy, rotation: gsap.utils.random(-45, 45), scale: 1, opacity: 0, duration, ease: 'power2.out', onComplete: () => el.remove() }
		);
	}

	if (!reduced) {
		// Estela de corazones al mover el mouse (solo con mouse, no en pantallas táctiles)
		let lastX = 0;
		let lastY = 0;
		window.addEventListener('pointermove', (e) => {
			if (e.pointerType !== 'mouse' || current >= 0) return;
			if (Math.hypot(e.clientX - lastX, e.clientY - lastY) < 38) return;
			lastX = e.clientX;
			lastY = e.clientY;
			spawnHeart(e.clientX, e.clientY, gsap.utils.random(-25, 25), gsap.utils.random(-70, -35), gsap.utils.random(10, 18), 1.2);
		});

		// Explosión de corazones al tocar / hacer clic en cualquier parte
		window.addEventListener('pointerdown', (e) => {
			if (current >= 0) return;
			for (let i = 0; i < 7; i++) {
				const angle = (Math.PI * 2 * i) / 7 + gsap.utils.random(-0.3, 0.3);
				const r = gsap.utils.random(45, 95);
				spawnHeart(e.clientX, e.clientY, Math.cos(angle) * r, Math.sin(angle) * r, gsap.utils.random(11, 20), 0.9);
			}
		});
	}

	// ---------- Contador ----------
	const counter = document.getElementById('contador')!;
	const start = new Date(counter.dataset.start!).getTime();
	const units = {
		days: counter.querySelector('[data-unit=days]')!,
		hours: counter.querySelector('[data-unit=hours]')!,
		minutes: counter.querySelector('[data-unit=minutes]')!,
		seconds: counter.querySelector('[data-unit=seconds]')!,
	};
	function tick() {
		const s = Math.floor(Math.max(0, Date.now() - start) / 1000);
		units.days.textContent = String(Math.floor(s / 86400));
		units.hours.textContent = String(Math.floor((s % 86400) / 3600));
		units.minutes.textContent = String(Math.floor((s % 3600) / 60));
		units.seconds.textContent = String(s % 60);
	}
	tick();
	setInterval(tick, 1000);
</script>
